# Copy this file to .env.local and fill it in. Never commit .env.local.

# Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Models (optional, these are the defaults)
GEMINI_CHAT_MODELS=gemini-3.6-flash,gemini-3.8-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_TTS_MODEL=gemini-3.8-flash-tts

# Long random string used to encrypt the sign-in cookie (32+ characters)
SESSION_SECRET=

# Only this Google account can use the assistant
ALLOWED_EMAIL=

# Google sign-in (Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID, type "Web application")
# Authorised redirect URI: http://localhost:3000/api/auth/callback (and your live URL + /api/auth/callback)
# Enable "Google Calendar API" and "Gmail API" in the same Google Cloud project.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Free web search: sign up at https://app.tavily.com (1,000 free searches/month, no card)
TAVILY_API_KEY=

# Images: "pollinations" (free, default) or "gemini" (needs Gemini billing; falls back to free if it fails)
IMAGE_PROVIDER=pollinations
